  "mantras": [
    {
      "id": "dhanvantari_mantra",
      "title": {
        "hi": "धन्वंतरि मंत्र",
        "en": "Dhanvantari Mantra"
      },
      "mantra": {
        "hi": "ॐ नमो भगवते वासुदेवाय धन्वंतरये अमृतकलशहस्ताय सर्वामयविनाशनाय त्रैलोक्यनाथाय श्रीमहाविष्णवे नमः॥",
        "transliteration": "Om Namo Bhagavate Vāsudevāya Dhanvantaraye Amṛtakalaśahastāya Sarvāmayavināśanāya Trailokyanāthāya Śrī Mahāviṣṇave Namaḥ"
      },
      "description": {
        "hi": "भगवान धन्वंतरि का सर्वाधिक प्रसिद्ध आरोग्य एवं आयुर्वेद संबंधी मंत्र।",
        "en": "The most widely recited healing mantra dedicated to Lord Dhanvantari, the divine physician."
      },
      "meaning": {
        "hi": "मैं भगवान धन्वंतरि को प्रणाम करता हूँ, जो अमृत कलश धारण करते हैं और समस्त रोगों का नाश करते हैं।",
        "en": "I bow to Lord Dhanvantari, bearer of the nectar pot and destroyer of all diseases."
      },
      "deities": [
        "dhanvantari"
      ],
      "deityInfo": {
        "primary": "dhanvantari",
        "group": "vaishnava",
        "parent": "vishnu"
      },
      "categories": [
        "dhanvantari",
        "healing"
      ],
      "keywords": {
        "hi": [
          "धन्वंतरि",
          "आरोग्य",
          "आयुर्वेद"
        ],
        "en": [
          "dhanvantari",
          "healing",
          "ayurveda"
        ]
      },
      "benefits": {
        "hi": [
          "आरोग्य",
          "मानसिक शांति",
          "रोगों से रक्षा",
          "सकारात्मकता",
          "आध्यात्मिक शक्ति",
          "भक्ति"
        ],
        "en": [
          "Health",
          "Peace",
          "Protection from illness",
          "Positivity",
          "Spiritual strength",
          "Devotion"
        ]
      },
      "purpose": [
        "healing",
        "health",
        "protection"
      ],
      "recommendedTime": [
        "morning"
      ],
      "recommendedOccasion": [
        "daily_japa",
        "dhanteras",
        "during_illness"
      ],
      "recommendedJapa": [
        11,
        27,
        108
      ],
      "usage": {
        "hi": "आरोग्य एवं आयुर्वेद साधना में।",
        "en": "For healing prayers and Ayurvedic spiritual practice."
      },
      "dailyRoutine": [
