  "mantras": [
    {
      "id": "kubera_mantra",
      "title": {
        "hi": "कुबेर मंत्र",
        "en": "Kubera Mantra"
      },
      "mantra": {
        "hi": "ॐ यक्षाय कुबेराय वैश्रवणाय धनधान्याधिपतये धनधान्यसमृद्धिं मे देहि दापय स्वाहा॥",
        "transliteration": "Om Yakṣāya Kuberāya Vaiśravaṇāya Dhanadhānyādhipataye Dhanadhānyasamṛddhiṁ Me Dehi Dāpaya Svāhā"
      },
      "description": {
        "hi": "धन के अधिपति भगवान कुबेर का प्रसिद्ध मंत्र, जो समृद्धि एवं धन-धान्य की वृद्धि के लिए जपा जाता है।",
        "en": "A renowned mantra of Lord Kubera, the deity of wealth, chanted for prosperity and abundance."
      },
      "meaning": {
        "hi": "हे वैश्रवण कुबेर! मुझे धन, धान्य एवं समृद्धि प्रदान करें।",
        "en": "O Kubera, Lord Vaishravana, bless me with wealth and abundance."
      },
