    {
      "id": "tulsi_prarthana",
      "title": {
        "hi": "तुलसी प्रार्थना",
        "en": "Tulsi Prayer"
      },
      "mantra": {
        "hi": "वृन्दायै तुलसीदेव्यै प्रियायै केशवस्य च। विष्णुभक्तिप्रदे देवि सत्यवत्यै नमो नमः॥",
        "transliteration": "Vṛndāyai Tulasīdevyai Priyāyai Keśavasya Ca Viṣṇubhaktiprade Devi Satyavatyai Namo Namaḥ"
      },
      "description": {
        "hi": "भगवान विष्णु की प्रिय तुलसी देवी की स्तुति एवं प्रार्थना।",
        "en": "A traditional prayer to Goddess Tulsi, beloved of Lord Vishnu."
      },
      "meaning": {
        "hi": "हे तुलसी देवी! आप भगवान केशव की प्रिय हैं। मुझे विष्णु भक्ति प्रदान करें।",
        "en": "O Goddess Tulsi, beloved of Lord Keshava, bless me with devotion to Lord Vishnu."
      },
