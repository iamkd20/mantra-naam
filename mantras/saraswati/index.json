    {
      "id": "ya_kundendu_tusharahara_dhavala",
      "title": {
        "hi": "या कुन्देन्दुतुषारहारधवला",
        "en": "Ya Kundendu Tusharahara Dhavala"
      },
      "mantra": {
        "hi": "या कुन्देन्दुतुषारहारधवला या शुभ्रवस्त्रावृता। या वीणावरदण्डमण्डितकरा या श्वेतपद्मासना॥",
        "transliteration": "Yā Kundendu Tuṣārahāra Dhavalā Yā Śubhravastrāvṛtā Yā Vīṇāvaradaṇḍamaṇḍitakarā Yā Śvetapadmāsanā"
      },
      "description": {
