    {
      "id": "mahamrityunjaya_mantra",
      "title": {
        "hi": "महामृत्युंजय मंत्र",
        "en": "Mahamrityunjaya Mantra"
      },
      "mantra": {
        "hi": "ॐ त्र्यम्बकं यजामहे सुगन्धिं पुष्टिवर्धनम्। उर्वारुकमिव बन्धनान्मृत्योर्मुक्षीय मामृतात्॥",
        "transliteration": "Om Tryambakaṁ Yajāmahe Sugandhiṁ Puṣṭivardhanam Urvārukamiva Bandhanān Mṛtyor Mukṣīya Mā'mṛtāt"
      },
      "description": {
